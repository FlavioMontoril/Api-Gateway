# URL do Frontend (ReactJS/Vite) para as configurações de CORS
# Múltiplas origens para dev (Vite na 5173) e prod (Nginx na 80 / localhost ou seu domínio)
FRONTEND_URL=http://localhost:5173,http://localhost

# URLs dos Microserviços
# Se estiver a correr localmente sem Docker, utilize http://localhost:PORTA
# Se estiver a correr no Docker Compose, o hostname deve corresponder ao nome do serviço
AUTH_SERVICE_URL=http://auth-service:8081
TASK_SERVICE_URL=http://task-service:8082

# Chave secreta para a validação dos tokens JWT (Se os serviços partilharem a mesma chave)
JWT_SECRET=suaChaveSecretaSuperSeguraComPeloMenos32CaracteresAqui